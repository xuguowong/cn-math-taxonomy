{
  "name": "cn-math-taxonomy",
  "version": "1.0.0",
  "description": "对齐《义务教育数学课程标准（2022 年版）》与人教版一–九的知识点 DAG，附**自适应前置诊断**与题库。答错会沿先修边从初中一直回溯到具体的小学知识点，并给出按年级从低到高排列的学习路径。仓库名仍是 `cn-math-taxonomy`。",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/test_engine.js && node tests/test_children.js && node tests/test_blindspots.js && npm run test:analysis && npm run test:navigation && npm run test:paper",
    "start": "node --env-file-if-exists=.env scripts/question-server.js",
    "test:analysis": "node --test tests/question-analysis.test.js tests/question-server.test.js",
    "test:navigation": "node --test tests/navigation.test.js",
    "test:paper": "node --test tests/paper.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyang111222/cn-math-taxonomy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/xiaoyang111222/cn-math-taxonomy/issues"
  },
  "homepage": "https://github.com/xiaoyang111222/cn-math-taxonomy#readme",
  "allowScripts": {
    "esbuild@0.27.3": true,
    "workerd@1.20260426.1": true,
    "sharp@0.34.5": true
  }
}
