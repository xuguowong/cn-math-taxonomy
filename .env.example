# Copy to .env. Requires Node.js >=22. No npm dependencies.
# OpenAI-compatible base URL INCLUDING /v1 (or your gateway's equivalent prefix).
# Examples: vLLM / SGLang / llama-server / LiteLLM.
MATH_AI_BASE_URL=http://127.0.0.1:8000/v1
MATH_AI_MODEL=your-model-name
# Optional for local servers without authentication. Never commit your actual key.
MATH_AI_API_KEY=
# Set to 1 only if the selected model AND server support image_url input.
MATH_AI_VISION=1
MATH_AI_TIMEOUT_MS=120000
PORT=8787
